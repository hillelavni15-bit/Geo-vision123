# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (local Postgres, Neon, Supabase, ...)
DATABASE_URL=postgres://postgres@localhost:5432/whereisthis

# Long random string that signs guest cookies. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

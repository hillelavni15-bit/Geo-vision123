# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (local Postgres, Neon, Supabase, ...)
DATABASE_URL=postgres://postgres@localhost:5432/whereisthis

# Optional: long random string that signs guest cookies (openssl rand -hex 32).
# If empty, a key is derived from DATABASE_URL.
SESSION_SECRET=

# OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
